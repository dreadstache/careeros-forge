{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careeros.dev/schemas/resume.schema.json",
  "title": "CareerOS Resume Data",
  "type": "object",
  "required": ["basics", "experience", "education", "skills", "projects"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "basics": {
      "type": "object",
      "required": ["name", "headline", "summary"],
      "properties": {
        "name": {"type": "string"},
        "headline": {"type": "string"},
        "summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "experience": {
      "type": "array",
      "items": {"$ref": "#/$defs/experience"}
    },
    "education": {
      "type": "array",
      "items": {"$ref": "#/$defs/education"}
    },
    "skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/skill"}
    },
    "projects": {
      "type": "array",
      "items": {"$ref": "#/$defs/project"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2})?$"
    },
    "experience": {
      "type": "object",
      "required": ["organization", "position", "start_date", "highlights"],
      "properties": {
        "id": {"$ref": "#/$defs/recordId"},
        "status": {"$ref": "#/$defs/status"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "organization": {"type": "string", "minLength": 1},
        "position": {"type": "string", "minLength": 1},
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "location": {"type": "string"},
        "summary": {"type": "string"},
        "highlights": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "education": {
      "type": "object",
      "required": ["institution", "credential", "start_date"],
      "properties": {
        "id": {"$ref": "#/$defs/recordId"},
        "status": {"$ref": "#/$defs/status"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "institution": {"type": "string", "minLength": 1},
        "credential": {"type": "string", "minLength": 1},
        "field": {"type": "string"},
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "location": {"type": "string"},
        "highlights": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": []
        }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": ["name", "keywords"],
      "properties": {
        "id": {"$ref": "#/$defs/recordId"},
        "status": {"$ref": "#/$defs/status"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "name": {"type": "string", "minLength": 1},
        "keywords": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["name", "summary", "highlights"],
      "properties": {
        "id": {"$ref": "#/$defs/recordId"},
        "status": {"$ref": "#/$defs/status"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "highlights": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "technologies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "recordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived"],
      "default": "active"
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "source_type": {
          "type": "string",
          "enum": ["verified_cv", "spreadsheet", "manual", "import"]
        },
        "imported_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
