{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careeros.dev/schemas/forge-config.schema.json",
  "title": "CareerOS Forge Configuration",
  "type": "object",
  "required": ["project_name"],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "output_directory": {
      "type": "string",
      "minLength": 1,
      "default": "./generated"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": ["base"]
    },
    "module_options": {
      "type": "object",
      "properties": {
        "resume": {
          "type": "object",
          "properties": {
            "data_file": {
              "type": "string",
              "minLength": 1
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slug", "title"],
                "properties": {
                  "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                  "title": {"type": "string", "minLength": 1},
                  "headline": {"type": "string", "minLength": 1},
                  "summary": {"type": "string", "minLength": 1},
                  "experience_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                  "skill_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                  "project_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
                },
                "additionalProperties": false
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {"type": "object"},
      "default": {}
    }
  },
  "additionalProperties": false
}
